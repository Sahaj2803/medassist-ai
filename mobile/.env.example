# Public config only — safe to bundle into the app.
# Never put GEMINI_API_KEY / GROQ_API_KEY / MONGO_URI / JWT_SECRET / SMTP_* here.

# Android emulator -> host machine's localhost is 10.0.2.2, NOT 127.0.0.1
# Physical device on same Wi-Fi -> use your computer's LAN IP, e.g. http://192.168.1.10:5000/api
# iOS simulator -> http://localhost:5000/api works directly
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
