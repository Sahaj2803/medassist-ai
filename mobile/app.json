{
  "expo": {
    "name": "MedAssist",
    "slug": "medassist-mobile",
    "scheme": "medassist",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/medassist-icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A1428"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medassist.mobile"
    },
    "android": {
      "package": "com.medassist.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/medassist-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "MedAssist uses your photos to let you upload prescriptions and lab reports.",
          "cameraPermission": "MedAssist uses your camera to scan prescriptions and lab reports."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/medassist-icon.png",
          "color": "#06B6D4"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8810ad64-0842-4489-a4ad-bb6e3330b651"
      }
    },
    "owner": "medassist2803"
  }
}
